---
import '@fontsource-variable/montserrat';
import '../styles/global.css';
import {site} from '../data/site';
const {title='Atocha sigue siendo tu casa',description='Encuentros, actividades e historia de la Asociación Antiguos Alumnos y Alumnas Salesianos Atocha.'}=Astro.props;
const base=import.meta.env.BASE_URL;
const url=(path='')=>`${base}${path}`;
const nav=[['asociacion/','La Asociación'],['actividades/','Qué hacemos'],['agenda/','Agenda'],['galeria/','Galería']];
const current=Astro.url.pathname;
---
<!doctype html><html lang="es"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#142a3a"/><link rel="icon" type="image/png" href={url('logo-asociacion.png')}/><title>{title} · AA.AA. Atocha</title><link rel="canonical" href={new URL(current,Astro.site)}/><meta property="og:title" content={`${title} · AA.AA. Atocha`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/></head><body>
<a class="skip" href="#contenido">Saltar al contenido</a>
<div class="topbar"><span>Una casa. Muchas generaciones.</span><a href={site.instagram} target="_blank" rel="noopener noreferrer">Encuéntranos en Instagram ↗</a></div>
<header class="header"><a class="brand" href={url()} aria-label="AA.AA. Atocha, inicio"><img class="brand-logo" src={url('logo-asociacion.png')} alt="Escudo de los Antiguos Alumnos y Alumnas de Don Bosco" width="350" height="350"/><span class="brand-description">Antiguos Alumnos y Alumnas<br/>de Don Bosco<br/>Salesianos Atocha · Madrid</span></a><button class="menu-toggle" aria-expanded="false" aria-controls="navigation">Menú <span aria-hidden="true">＋</span></button><nav id="navigation" aria-label="Principal">{nav.map(([path,label])=><a href={url(path)} aria-current={current===url(path)?'page':undefined}>{label}</a>)}<a class="nav-cta" href={url('participa/')}>Forma parte <span aria-hidden="true">↗</span></a></nav></header>
<main id="contenido"><slot/></main>
<footer><div class="footer-main"><div><a class="footer-brand" href={url()}><img class="footer-logo" src={url('logo-asociacion.png')} alt="Escudo de los Antiguos Alumnos y Alumnas de Don Bosco" width="350" height="350" loading="lazy"/><div>AA.AA. ATOCHA<span>El vínculo continúa.</span></div></a><p>{site.name}</p></div><div><span class="eyebrow">Nos encontramos</span><a href={url('contacto/')}>Contacto y ubicación ↗</a><a href={`mailto:${site.email}`}>{site.email}</a></div><div><span class="eyebrow">Sigue la vida de Atocha</span><a href={site.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a><a href={site.facebook} target="_blank" rel="noopener noreferrer">Facebook ↗</a><a href="https://salesianosatocha.es/" target="_blank" rel="noopener noreferrer">Salesianos Atocha ↗</a></div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} AA.AA. Salesianos Atocha</span><div><a href={url('fuentes/')}>Fuentes y fotografías</a><a href={url('privacidad/')}>Privacidad</a></div></div></footer>
<script>
const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle'); const nav=document.querySelector('#navigation');
toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!open));nav?.classList.toggle('open',!open)});
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&toggle?.getAttribute('aria-expanded')==='true'){toggle.setAttribute('aria-expanded','false');nav?.classList.remove('open');toggle.focus()}});
</script></body></html>
