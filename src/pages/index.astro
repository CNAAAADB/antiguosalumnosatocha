---
import Layout from '../layouts/Layout.astro';
import {site,photos,activities,upcomingEvents} from '../data/site';
import {nextConnectingMeeting} from '../data/connecting';
const b=import.meta.env.BASE_URL; const events=upcomingEvents(); const nextConnecting=nextConnectingMeeting();
---
<Layout>
<section class="hero wrap"><div class="hero-copy"><p class="eyebrow"><span class="gold-line"></span> Antiguos Alumnos y Alumnas de Don Bosco</p><h1>Hay cosas<br/>que se quedan.<br/><span>Atocha, también.</span></h1><div class="hero-bottom"><p>La comunidad de antiguos alumnos y alumnas de Salesianos Atocha. Amistad, encuentros y compromiso salesiano en Madrid.</p><a class="round-link" href={`${b}asociacion/`} aria-label="Conoce la Asociación">↗</a></div></div><figure class="hero-photo"><img src={photos[0].src} alt={photos[0].alt} fetchpriority="high" width="1600" height="1000"/><figcaption>01 / El lugar donde empieza todo <span>ATOCHA, MADRID</span></figcaption></figure><div class="hero-side">ENCUENTRO · AMISTAD · COMPROMISO</div></section>
<section class="intro wrap"><p class="eyebrow">Antiguos alumnos de Salesianos Atocha</p><div><h2>Salimos de las aulas.<br/>Seguimos <span class="underlined">conectados.</span></h2><div class="intro-text"><p>Somos la Asociación Antiguos Alumnos y Alumnas Salesianos Atocha. Como antiguos alumnos y alumnas de Don Bosco, seguimos vinculados al colegio en Madrid a través de encuentros, deporte, cultura e iniciativas solidarias.</p><a class="text-link" href={`${b}asociacion/`}>Conoce la Asociación <span>↗</span></a></div></div></section>
<section class="connecting-feature wrap"><div><p class="eyebrow">Encuentro · Convivencia · Participación juvenil</p><h2>Connecting.<br/><span>Hacemos comunidad.</span></h2><p>Un espacio para conectar entre jóvenes con y sin origen migrante, compartir experiencias y seguir construyendo vínculos en Atocha.</p>{nextConnecting && <p class="connecting-feature-date">Próximo encuentro: <time datetime={nextConnecting.date}>{new Intl.DateTimeFormat('es-ES',{day:'numeric',month:'long',timeZone:'Europe/Madrid'}).format(new Date(nextConnecting.date))}</time> · 17:30 h</p>}<a class="text-link" href={`${b}connecting/`}>Descubre Connecting <span>↗</span></a></div><a class="connecting-feature-poster" href={`${b}connecting/`} aria-label="Conoce Connecting y sus encuentros"><img src={`${b}images/connecting/en-equipo.png`} width="365" height="548" loading="lazy" alt="Cartel del segundo encuentro de Connecting: En equipo"/></a></section>
<section class="life"><div class="wrap"><div class="section-heading"><div><p class="eyebrow">La vida de la Asociación</p><h2>Siempre hay<br/>motivos para volver.</h2></div><a class="text-link" href={`${b}actividades/`}>Qué hacemos <span>↗</span></a></div><div class="life-grid"><a class="feature-photo" href={`${b}galeria/`}><img src={photos[1].src} alt={photos[1].alt} loading="lazy" width="1000" height="700"/><div><span class="eyebrow">Atocha · Octubre 2026</span><h3>Una casa que reúne<br/>a muchas generaciones.</h3><span class="photo-action">Ver fotografías ↗</span></div></a><div class="activity-list">{activities.map(a=><a href={`${b}actividades/${a.slug}/`}><span class="activity-number">{a.number}</span><div><span class="eyebrow">{a.tag}</span><h3>{a.title}</h3><p>{a.text}</p></div><span class="arrow">↗</span></a>)}</div></div></div></section>
<section class="agenda wrap"><div><p class="eyebrow">La próxima vez</p><h2>Nos vemos<br/>en Atocha.</h2><a class="text-link" href={`${b}agenda/`}>Consulta la agenda <span>↗</span></a></div><div class="agenda-panel"><span class="eyebrow">Próximas actividades</span>{events.length ? events.slice(0,3).map(e=><a class="event-row" href={e.url}><time datetime={e.date}>{new Intl.DateTimeFormat('es-ES',{day:'numeric',month:'long',timeZone:'Europe/Madrid'}).format(new Date(e.date))}</time><h3>{e.title}</h3><span>↗</span></a>):<><h3>El siguiente encuentro<br/>lo compartimos aquí.</h3><p>Consulta también nuestras redes para seguir las convocatorias de la Asociación.</p><a class="text-link" href={site.instagram} target="_blank" rel="noopener noreferrer">Ir a Instagram <span>↗</span></a></>}</div></section>
<section class="history"><div class="wrap history-grid"><figure><img src={photos[2].src} alt={photos[2].alt} loading="lazy" width="1100" height="800"/><figcaption>Vista histórica de Atocha · Décadas de 1960–1970</figcaption></figure><div><p class="eyebrow">Nuestra memoria compartida</p><span class="year">1901<span>El inicio de la casa de Atocha</span></span><h2>Muchas historias.<br/>Un mismo lugar.</h2><p>La historia de la casa salesiana forma parte de la nuestra. Aulas, talleres y patios que han unido a generaciones de jóvenes en Madrid.</p><a class="text-link" href={`${b}asociacion/historia/`}>Recorre nuestra historia <span>↗</span></a></div></div></section>
<section class="join wrap"><p class="eyebrow">El vínculo continúa contigo</p><h2>Tu etapa en el colegio terminó.<br/><span>Tu sitio en Atocha, no.</span></h2><div><p>Acércate, comparte una idea o vuelve a encontrarte con nosotros. Hay muchas maneras de formar parte.</p><a class="button" href={`${b}participa/`}>Quiero participar <span>↗</span></a></div></section>
</Layout>
