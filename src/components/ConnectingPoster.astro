---
import {connecting} from '../data/connecting';
const {poster='cartel-general.png',width=400,height=500,legacyFooter=true,label='Connecting: encuentro, convivencia y participación juvenil',eager=false}=Astro.props;
const b=import.meta.env.BASE_URL;
const source=b+'images/connecting/'+poster;
---
<div class="connecting-poster">
 {legacyFooter ? <>
  <svg viewBox={`0 0 ${width} ${poster==='cartel-general.png' ? 443 : 449}`} role="img" aria-label={label}>
   <image href={source} width={width} height={height}/>
  </svg>
  <div class="connecting-poster-funding">
   <img src={b+'images/connecting/eu-emblem.svg'} width="90" height="60" alt="Emblema de la Unión Europea" loading={eager?'eager':'lazy'}/>
   <span>{connecting.funding}</span>
  </div>
 </> : <img class="connecting-poster-full" src={source} alt={label} width={width} height={height} loading={eager?'eager':'lazy'}/>}
</div>
